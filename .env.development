# .env file
NODE_ENV=development
# PostgreSQL credentials
DB_TYPE=postgres
POSTGRES_CONTAINER_NAME=nestjs_postgres_container
POSTGRES_HOST=127.0.0.1 # on pgadmin use internal host e.g. host will be db
POSTGRES_PORT=5432
POSTGRES_USER=nestjs_app_user
POSTGRES_PASSWORD=nestjs_app_password
POSTGRES_DB=nestjs_app_db
DB_SYNC=true

# pgAdmin credentials
PGADMIN_HOST= db # use this host to connect to postgres container in pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=adminpassword